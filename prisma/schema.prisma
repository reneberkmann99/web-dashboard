generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
  CLIENT_ADMIN
  CLIENT_OPERATOR
  CLIENT_VIEWER
}

enum AuthSource {
  LOCAL
  PAM
}

enum NodeStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  INACTIVE
}

enum OperationState {
  REQUESTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum ProjectSource {
  MANUAL
  COMPOSE
}

/**
 * Where a managed deployment's revision content originates. Only HOSTPANEL is
 * usable in Phase 6A; GIT is reserved for a future source (no code path
 * creates it and the service layer rejects it).
 */
enum DeploymentSource {
  HOSTPANEL
  GIT
}

/**
 * Security policy under which a revision was authored + must be re-validated.
 */
enum DeploymentPolicy {
  ADMIN
  CLIENT
}

enum DeploymentOperationType {
  DEPLOY
  ROLLBACK
}

enum DeploymentOperationPhase {
  VALIDATING
  PLANNING
  WAITING_FOR_CONFIRMATION
  PREPARING
  REVALIDATING
  PULLING
  APPLYING
  VERIFYING
  RECONCILING
}

enum FindingSeverity {
  INFO
  WARNING
  HIGH_RISK
  BLOCKED
}

enum FindingCategory {
  SECURITY
  UNSUPPORTED
  INVALID
}

enum ReleaseHealth {
  HEALTHY
  DEGRADED
}

enum RuntimeState {
  UNKNOWN
  CONVERGED
  DEGRADED
  DRIFTED
}

enum NodeTransportMode {
  LEGACY_HTTP
  TLS_VERIFIED
  TLS_ERROR
}

enum NodeCertificateStatus {
  ACTIVE
  SUPERSEDED
  REVOKED
  EXPIRED
}

/**
 * Operational attention severity (Phase 6D). Distinct from Docker runtime state.
 */
enum AttentionSeverity {
  CRITICAL
  WARNING
  INFO
}

/**
 * What kind of resource an AttentionState/condition targets.
 */
enum AttentionResourceType {
  NODE
  CONTAINER
  WORKLOAD
  OPERATION
  DEPLOYMENT
}

/**
 * Phase 6E: what an AttentionSilence or MaintenanceWindow targets.
 */
enum LifecycleScopeType {
  CONDITION
  NODE
  WORKLOAD
}

enum MaintenanceNotificationBehavior {
  SUPPRESS
  KEEP
}

enum NotificationDestinationType {
  WEBHOOK
}

enum NotificationEventType {
  CONDITION_OPENED
  SEVERITY_ESCALATED
  CONDITION_RESOLVED
  SILENCE_EXPIRED_STILL_ACTIVE
  TEST_NOTIFICATION
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  SUPPRESSED
}

model ClientAccount {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  isActive    Boolean               @default(true)
  users       User[]
  projects    Project[]
  assignments ContainerAssignment[]
  grants      AccessGrant[]
  operations  Operation[]
  auditLogs   AuditLog[]
  nodeAccess  ClientNodeAccess[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([isActive])
}

/**
 * Node allowlist for tenant self-service: which nodes a client may deploy
 * workloads on. Admin-managed; empty = the client cannot create workloads.
 */
model ClientNodeAccess {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  nodeId          String
  node            Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([clientAccountId, nodeId])
  @@index([clientAccountId])
  @@index([nodeId])
}

model User {
  id                                 String                              @id @default(cuid())
  email                              String                              @unique
  displayName                        String
  passwordHash                       String? // null while a locally-managed account is still pending activation
  authSource                         AuthSource                          @default(LOCAL)
  pamUsername                        String?                             @unique
  role                               Role                                @default(CLIENT_OPERATOR)
  isActive                           Boolean                             @default(true)
  lastLoginAt                        DateTime?
  clientAccountId                    String?
  clientAccount                      ClientAccount?                      @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  sessions                           Session[]
  auditLogs                          AuditLog[]
  operations                         Operation[]
  deploymentRevisions                DeploymentRevision[]
  secretVersions                     SecretVersion[]
  deploymentSecurityAcknowledgements DeploymentSecurityAcknowledgement[]
  deploymentOperations               DeploymentOperation[]
  activationToken                    ActivationToken?
  attentionAcknowledgementsMade      AttentionAcknowledgement[]          @relation("AttentionAcknowledgedBy")
  attentionAcknowledgementsCleared   AttentionAcknowledgement[]          @relation("AttentionAcknowledgementCleared")
  attentionSilencesCreated           AttentionSilence[]                  @relation("AttentionSilenceCreatedBy")
  attentionSilencesCancelled         AttentionSilence[]                  @relation("AttentionSilenceCancelledBy")
  maintenanceWindowsCreated          MaintenanceWindow[]                 @relation("MaintenanceWindowCreatedBy")
  maintenanceWindowsCancelled        MaintenanceWindow[]                 @relation("MaintenanceWindowCancelledBy")
  notificationDestinationsCreated    NotificationDestination[]
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt

  @@index([clientAccountId])
  @@index([role])
  @@index([pamUsername])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ActivationToken {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

model Node {
  id                 String                 @id @default(cuid())
  name               String
  hostname           String                 @unique
  apiBaseUrl         String
  apiKeyEncrypted    String
  dockerContext      String?
  status             NodeStatus             @default(UNKNOWN)
  transportMode      NodeTransportMode      @default(LEGACY_HTTP)
  isActive           Boolean                @default(true)
  lastHeartbeatAt    DateTime?
  agentVersion       String?
  dockerVersion      String?
  composeSupported   Boolean?
  composeVersion     String?
  // Secure agent transport. `transportMode` is a persisted STATUS/UX hint set
  // only after a live verified-HTTPS check — it is never the root of trust:
  // every managed mutation independently performs full TLS verification.
  tlsApiBaseUrl      String?
  lastTlsVerifiedAt  DateTime?
  lastTlsError       String?
  certificates       NodeAgentCertificate[]
  osInfo             Json?
  systemInfo         Json? // cpu / memory / disk snapshots from agent /info
  enrollmentTokens   NodeEnrollmentToken[]
  projects           Project[]
  assignments        ContainerAssignment[]
  containers         Container[]
  grants             AccessGrant[]
  operations         Operation[]
  clientAccess       ClientNodeAccess[]
  attentionSilences  AttentionSilence[]
  maintenanceWindows MaintenanceWindow[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([isActive])
  @@index([status])
}

model NodeEnrollmentToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  nodeId      String?
  node        Node?     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

/**
 * A Project may have NO client (an "internal" / unassigned workload visible
 * only to ADMIN — nothing is granted to any tenant until an AccessGrant
 * exists). `clientAccountId` is therefore nullable; ownership/ACL is always
 * resolved through `AccessGrant`, never inferred from this field alone (see
 * `resolveVisibleContainersForSession` in containers.ts). Slug uniqueness is
 * scoped per-node (not per-client) so an internal workload's slug can't
 * collide with anything else on the same node regardless of client.
 */
model Project {
  id                 String                @id @default(cuid())
  name               String
  slug               String
  description        String?
  source             ProjectSource         @default(MANUAL)
  composeProject     String?
  isActive           Boolean               @default(true)
  clientAccountId    String?
  clientAccount      ClientAccount?        @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  nodeId             String
  node               Node                  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  assignments        ContainerAssignment[]
  containers         Container[]
  grants             AccessGrant[]
  deployment         Deployment?
  attentionSilences  AttentionSilence[]
  maintenanceWindows MaintenanceWindow[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([nodeId, slug])
  @@unique([nodeId, composeProject])
  @@index([nodeId])
  @@index([source])
  @@index([clientAccountId])
}

/**
 * Discovered Docker container inventory, one row per (node, dockerContainerId).
 * This is the identity that permissions reference — administrators never type
 * container IDs by hand; they pick from what the node agent reported.
 */
model Container {
  id                String                @id @default(cuid())
  nodeId            String
  node              Node                  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  dockerContainerId String
  dockerName        String
  image             String?
  composeProject    String?
  composeService    String?
  lastKnownStatus   String?
  firstSeenAt       DateTime              @default(now())
  lastSeenAt        DateTime              @default(now())
  isActive          Boolean               @default(true)
  assignments       ContainerAssignment[]
  grants            AccessGrant[]
  operations        Operation[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([nodeId, dockerContainerId])
  @@index([nodeId, isActive])
  @@index([projectId])
}

/**
 * Compatibility grant row (pre-refactor): container-level access grants created
 * before AccessGrant existed. New grants are created as AccessGrant rows; this
 * table is retained so historical records and existing URLs keep resolving.
 */
model ContainerAssignment {
  id                String        @id @default(cuid())
  clientAccountId   String
  clientAccount     ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  nodeId            String
  node              Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  containerId       String?
  container         Container?    @relation(fields: [containerId], references: [id], onDelete: SetNull)
  dockerContainerId String
  dockerName        String
  image             String?
  friendlyLabel     String?
  allowedActions    String[]      @default(["start", "stop", "restart"])
  isActive          Boolean       @default(true)
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([nodeId, dockerContainerId])
  @@index([clientAccountId])
  @@index([projectId])
  @@index([containerId])
}

/**
 * Unified access grant. A grant targets exactly one of:
 * - a Project (normal case: "Client X may operate stack Y")
 * - a Container (exception case: container-specific access)
 */
model AccessGrant {
  id              String        @id @default(cuid())
  clientAccountId String
  clientAccount   ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  nodeId          String
  node            Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  containerId     String?
  container       Container?    @relation(fields: [containerId], references: [id], onDelete: Cascade)
  allowedActions  String[]      @default(["start", "stop", "restart"])
  isActive        Boolean       @default(true)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([clientAccountId, projectId])
  @@unique([clientAccountId, containerId])
  @@index([clientAccountId, isActive])
  @@index([nodeId])
}

/**
 * Asynchronous operational action lifecycle. Container start/stop/restart go
 * through this queue so the UI gets clear feedback and concurrent conflicting
 * actions on the same container are prevented (partial unique index enforced
 * in the migration: at most one active operation per container).
 */
model Operation {
  id                 String         @id @default(cuid())
  type               String // e.g. CONTAINER_START / CONTAINER_STOP / CONTAINER_RESTART
  state              OperationState @default(REQUESTED)
  requestId          String // correlation id exposed to the caller
  actorUserId        String?
  actorUser          User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail         String?
  actorRole          Role?
  clientAccountId    String?
  clientAccount      ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  nodeId             String
  node               Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  dockerContainerId  String
  containerId        String?
  container          Container?     @relation(fields: [containerId], references: [id], onDelete: SetNull)
  targetAssignmentId String? // legacy ContainerAssignment id when the action originated there
  error              String?
  result             Json?
  requestedAt        DateTime       @default(now())
  queuedAt           DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([nodeId, state])
  @@index([dockerContainerId, state])
  @@index([requestId])
}

model AuditLog {
  id              String         @id @default(cuid())
  actorUserId     String?
  actorUser       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail      String?
  actorRole       Role?
  clientAccountId String?
  clientAccount   ClientAccount? @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  action          String
  targetType      String
  targetId        String?
  metadata        Json?
  result          AuditResult
  sourceIp        String?
  createdAt       DateTime       @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@index([clientAccountId])
  @@index([clientAccountId, createdAt])
  @@index([result, createdAt])
}

/**
 * Managed Compose deployment (Phase 6A).
 * Ownership of a workload's deployment definition is represented by the
 * PRESENCE of a Deployment row attached to a Project — never by a new
 * Project.source value. `Project.source` stays MANUAL|COMPOSE (membership
 * semantics). A workload is MANAGED_COMPOSE iff this relation exists.
 * Deletion: Project -> Deployment is RESTRICT so a managed workload cannot be
 * hard-deleted through cascades; normal application behavior uses
 * deactivate/detach instead. Revision/secret history is likewise RESTRICT
 * upstream so it cannot be silently wiped by removing a workload record.
 */
model Deployment {
  id                   String                @id @default(cuid())
  projectId            String                @unique
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  source               DeploymentSource      @default(HOSTPANEL)
  composeProjectName   String
  // Runtime pointers. Both null until the first successful deployment.
  //   currentReleaseId     = the DeploymentRelease HostPanel can prove matches
  //                          current runtime config (may be a DEGRADED release)
  //   lastHealthyReleaseId = most recent HEALTHY release (rollback default)
  // These are plain CUID pointers to DeploymentRelease.id (no FK) — always set
  // transactionally by the executor alongside release creation.
  currentReleaseId     String?
  lastHealthyReleaseId String?
  runtimeState         RuntimeState          @default(UNKNOWN)
  verifyGraceMs        Int                   @default(30000)
  revisions            DeploymentRevision[]
  secrets              Secret[]
  operations           DeploymentOperation[]
  releases             DeploymentRelease[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([projectId])
}

/**
 * Immutable deployment revision. No UPDATE path mutates composeSource,
 * composeCanonical, environmentSnapshot or secretReferences after creation.
 * Identical content is deduplicated via the (deploymentId, contentSha256)
 * unique constraint. Secret VALUES are never stored here — only the keys in
 * secretReferences.
 */
model DeploymentRevision {
  id                                 String                              @id @default(cuid())
  deploymentId                       String
  deployment                         Deployment                          @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  revisionNumber                     Int
  source                             DeploymentSource                    @default(HOSTPANEL)
  sourceRef                          String?
  policy                             DeploymentPolicy                    @default(ADMIN)
  composeSource                      String
  composeCanonical                   String
  environmentSnapshot                Json
  secretReferences                   String[]
  contentSha256                      String
  deployNote                         String?
  analyzerVersion                    String
  createdById                        String?
  createdBy                          User?                               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  findings                           DeploymentRevisionSecurityFinding[]
  createdAt                          DateTime                            @default(now())
  deploymentSecurityAcknowledgements DeploymentSecurityAcknowledgement[]
  deploymentReleases                 DeploymentRelease[]

  @@unique([deploymentId, revisionNumber])
  @@unique([deploymentId, contentSha256])
  @@index([deploymentId])
}

/**
 * Deployment-scoped secret identity. No latest-version pointer — the latest
 * version is the highest SecretVersion.versionNumber (immutable versions, no
 * hard delete in normal behavior). Soft-disable via isActive=false.
 */
model Secret {
  id           String          @id @default(cuid())
  deploymentId String
  deployment   Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  key          String
  isActive     Boolean         @default(true)
  versions     SecretVersion[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([deploymentId, key])
  @@index([deploymentId])
}

/**
 * Encrypted secret value version. ciphertext is AES-256-GCM(iv:tag:ct) keyed
 * by DEPLOYMENT_SECRETS_KEY. Versions are immutable and appended on rotation.
 */
model SecretVersion {
  id            String   @id @default(cuid())
  secretId      String
  secret        Secret   @relation(fields: [secretId], references: [id], onDelete: Restrict)
  versionNumber Int
  ciphertext    String
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@unique([secretId, versionNumber])
  @@index([secretId])
}

/**
 * Snapshot of a security/unsupported/validation finding produced when a
 * revision was created (analyzerVersion records the policy at that time).
 * Fingerprint is deterministic and identity-bearing (see server analyzer).
 */
model DeploymentRevisionSecurityFinding {
  id              String             @id @default(cuid())
  revisionId      String
  revision        DeploymentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  ruleId          String
  fingerprint     String
  severity        FindingSeverity
  category        FindingCategory
  service         String?
  resourcePath    String?
  settingValue    String?
  message         String
  analyzerVersion String
  createdAt       DateTime           @default(now())

  @@unique([revisionId, fingerprint])
  @@index([revisionId])
}

/**
 * ADMIN acknowledgment of a HIGH_RISK finding, stored separately from the
 * immutable revision so analyzer policy changes never mutate revision content.
 * BLOCKED findings can never be acknowledged. Unique per (revision, fingerprint).
 */
model DeploymentSecurityAcknowledgement {
  id                 String             @id @default(cuid())
  revisionId         String
  revision           DeploymentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  findingFingerprint String
  ruleId             String
  acknowledgedById   String?
  acknowledgedBy     User?              @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt     DateTime           @default(now())

  @@unique([revisionId, findingFingerprint])
  @@index([revisionId])
}

/**
 * Future deployment execution lifecycle (Phase 6B). Established now only to
 * fix the locking contract: at most one active (non-terminal) operation per
 * deployment, enforced by a PARTIAL unique index added in the migration (see
 * migration SQL, mirroring Operation_one_active_per_container). No executor
 * uses this table in Phase 6A.
 */
model DeploymentOperation {
  id             String                    @id @default(cuid())
  type           DeploymentOperationType
  state          OperationState            @default(REQUESTED)
  phase          DeploymentOperationPhase?
  requestId      String
  deploymentId   String
  deployment     Deployment                @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  revisionId     String?
  fromRevisionId String?
  actorUserId    String?
  actorUser      User?                     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmail     String?
  actorRole      Role?
  error          String?
  result         Json?
  requestedAt    DateTime                  @default(now())
  queuedAt       DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([deploymentId, state])
  @@index([requestId])
}

/**
 * A runtime release: HostPanel observed the managed workload converge to a
 * particular revision using a particular set of resolved runtime inputs
 * (image digests, secret versions). Distinct from DeploymentRevision (desired
 * config) — redeploying the same revision with a different secret version or
 * image digest produces a DIFFERENT release.
 */
model DeploymentRelease {
  id             String                    @id @default(cuid())
  deploymentId   String
  deployment     Deployment                @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  revisionId     String
  revision       DeploymentRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  operationId    String?
  healthVerdict  ReleaseHealth
  composeVersion String?
  appliedAt      DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime                  @default(now())
  images         DeploymentReleaseImage[]
  secrets        DeploymentReleaseSecret[]

  @@index([deploymentId, createdAt])
  @@index([revisionId])
}

/**
 * Actual image identity (tag + resolved digest) used by a release. Mutable tags
 * can resolve to a different digest on each deployment of the same revision,
 * so this snapshot belongs to the Release, never the Revision.
 */
model DeploymentReleaseImage {
  id          String            @id @default(cuid())
  releaseId   String
  release     DeploymentRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  serviceName String
  /// Desired image reference from the revision, e.g. "alpine:3.20" (mutable tag).
  imageRef    String
  /// ACTUAL local image ID of the running container (docker inspect .Image),
  /// e.g. "sha256:...". Proves what image configuration actually ran.
  imageId     String?
  /// Registry content-addressed identity when available, e.g. "alpine@sha256:...".
  repoDigest  String?

  @@unique([releaseId, serviceName])
  @@index([releaseId])
}

/**
 * Issued agent server certificate metadata (never private keys). Exactly one
 * ACTIVE certificate per node; the control plane pins the connection to this
 * fingerprint/serial, so a cryptographically valid but superseded/revoked cert
 * (or another node's valid cert) is rejected.
 */
model NodeAgentCertificate {
  id                String                @id @default(cuid())
  nodeId            String
  node              Node                  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  serialNumber      String
  fingerprintSha256 String
  subjectIdentity   String
  status            NodeCertificateStatus @default(ACTIVE)
  notBefore         DateTime
  notAfter          DateTime
  issuedAt          DateTime              @default(now())
  verifiedAt        DateTime?
  revokedAt         DateTime?
  createdAt         DateTime              @default(now())

  @@unique([fingerprintSha256])
  @@index([nodeId, status])
  @@index([notAfter])
}

/**
 * Secret VERSION IDs used by a release — never values. Enables surfacing
 * "secret changed since release; redeploy required".
 */
model DeploymentReleaseSecret {
  id              String            @id @default(cuid())
  releaseId       String
  release         DeploymentRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  secretId        String
  secretVersionId String
  key             String
  versionNumber   Int

  @@unique([releaseId, key])
  @@index([releaseId])
}

/**
 * Attention model (Phase 6D — fleet operations UX).
 * Restart-rate detection: a lightweight append-only sample is written only
 * when a container's cumulative `RestartCount` (as reported by `docker
 * inspect`) increases since the last observed value. Rate is derived by
 * summing samples inside a rolling window (see server/services/attention.ts),
 * never by a full time-series store — this is intentionally NOT a metrics
 * platform. Old samples are pruned (>24h) during the throttled sync pass.
 * Keyed by (nodeId, dockerContainerId) rather than Container.id because not
 * every discovered container has a Container row (e.g. never adopted).
 */
model ContainerRestartSample {
  id                String   @id @default(cuid())
  nodeId            String
  dockerContainerId String
  restartCount      Int
  observedAt        DateTime @default(now())

  @@index([nodeId, dockerContainerId, observedAt])
}

/**
 * Node resource pressure history (Phase 6D). One row per node roughly every
 * 60s (throttled in-process, mirroring the existing Compose reconcile
 * throttle pattern) — enough to require SUSTAINED pressure (not a single
 * poll spike) before raising a WARNING/CRITICAL attention item. Pruned (>24h)
 * during the same throttled pass. Deliberately not a general metrics/time-
 * series platform — see ARCHITECTURE.md Phase 6D notes.
 */
model NodeResourceSample {
  id          String   @id @default(cuid())
  nodeId      String
  cpuPercent  Float?
  memPercent  Float?
  diskPercent Float?
  observedAt  DateTime @default(now())

  @@index([nodeId, observedAt])
}

/**
 * Lightweight active-condition model (Phase 6D). One mutable row per
 * (resourceType, resourceId, conditionType) — NOT a full incidents/history
 * table (see ARCHITECTURE.md "Known limitations" for the documented
 * trade-off). Exists so:
 * 1. Activity logging records only STATE TRANSITIONS ("X became offline",
 * "X recovered"), never one entry per poll.
 * 2. The "needs attention" list can be deduplicated/backend-derived
 * instead of purely recomputed frontend state.
 * 3. A future notifier can subscribe to the same backend-derived condition
 * set (NODE_OFFLINE, WORKLOAD_DEGRADED, CONTAINER_CRASH_LOOP, …)
 * without scraping UI state (see brief §25).
 * `resolvedAt` is cleared (set back to null) and `firstObservedAt` reset when
 * a previously-resolved condition re-opens — no separate history rows are
 * kept per re-occurrence; that is the documented limitation of this phase.
 */
model AttentionState {
  id                 String                     @id @default(cuid())
  resourceType       AttentionResourceType
  resourceId         String
  conditionType      String
  severity           AttentionSeverity
  title              String
  detail             String
  href               String?
  metadata           Json?
  firstObservedAt    DateTime                   @default(now())
  lastObservedAt     DateTime                   @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  acknowledgements   AttentionAcknowledgement[]
  silences           AttentionSilence[]
  notificationEvents NotificationEvent[]

  @@unique([resourceType, resourceId, conditionType])
  @@index([resolvedAt])
  @@index([severity, resolvedAt])
}

/**
 * Operator-lifecycle model (Phase 6E). Kept as separate relations from
 * AttentionState rather than nullable fields bolted onto it — see
 * ARCHITECTURE.md "Phase 6E" for the rationale (AttentionState stays a pure
 * derived-condition mirror; lifecycle/audit concerns live here so a future
 * notifier/acker never has to distinguish "derived" vs "operator-entered"
 * fields on the same row).
 * Acknowledgement history is append-only: acknowledging creates a new row;
 * unacknowledging sets `clearedAt` on the currently active row (never a hard
 * delete) so the full operator history survives. At most one ACTIVE
 * (clearedAt IS NULL) acknowledgement per AttentionState is enforced by a
 * partial unique index added in the migration SQL (mirrors the existing
 * Operation one-active-per-container pattern).
 * When the underlying AttentionState resolves, the active acknowledgement is
 * also auto-cleared (clearedReason="condition_resolved") by the same sync
 * pass that resolves the condition — see server/services/attention.ts. This
 * keeps acknowledgement scoped to a single occurrence: AttentionState rows
 * are reused across resolve/reopen cycles (see that model's doc comment), so
 * a stale acknowledgement must never silently carry over into a genuinely
 * new occurrence of the same condition type on the same resource.
 */
model AttentionAcknowledgement {
  id               String         @id @default(cuid())
  attentionStateId String
  attentionState   AttentionState @relation(fields: [attentionStateId], references: [id], onDelete: Cascade)
  acknowledgedById String?
  acknowledgedBy   User?          @relation("AttentionAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  acknowledgedAt   DateTime       @default(now())
  note             String?
  clearedById      String?
  clearedBy        User?          @relation("AttentionAcknowledgementCleared", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt        DateTime?
  clearedReason    String? // e.g. "manual" | "condition_resolved"

  @@index([attentionStateId])
  @@index([attentionStateId, clearedAt])
}

/**
 * Temporary notification silence (Phase 6E). Suppresses NotificationDelivery
 * for a scope without altering AttentionState/operational severity. Backend
 * is the sole authority on "is this silence currently active" — computed as
 * `cancelledAt IS NULL AND now() < endsAt` at read/notify time, never a
 * client-side timer. `scope=CONDITION` targets one AttentionState directly;
 * `scope=NODE`/`scope=WORKLOAD` target every condition rooted at that
 * resource (see server/services/notifications.ts silence-resolution logic,
 * mirroring the existing attention node/workload rollup).
 * `expiredNotifiedAt` makes "one still-active notification when a silence
 * expires while the condition remains active" (brief §6) idempotent: set
 * once the SILENCE_EXPIRED_STILL_ACTIVE NotificationEvent has been created
 * for this silence, so a poll loop never floods duplicates.
 */
model AttentionSilence {
  id                String             @id @default(cuid())
  scope             LifecycleScopeType
  attentionStateId  String?
  attentionState    AttentionState?    @relation(fields: [attentionStateId], references: [id], onDelete: Cascade)
  nodeId            String?
  node              Node?              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  workloadId        String?
  workload          Project?           @relation(fields: [workloadId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?              @relation("AttentionSilenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reason            String?
  startsAt          DateTime           @default(now())
  endsAt            DateTime
  cancelledAt       DateTime?
  cancelledById     String?
  cancelledBy       User?              @relation("AttentionSilenceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  expiredNotifiedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([attentionStateId])
  @@index([nodeId])
  @@index([workloadId])
  @@index([endsAt])
}

/**
 * Intentional maintenance metadata (Phase 6E). Policy/notification-suppression
 * only — beginning or ending a maintenance window never mutates Docker state
 * or AttentionState. Underlying telemetry stays truthful throughout (brief
 * §9): an OFFLINE node under maintenance is still reported OFFLINE, just with
 * maintenance context attached and (per `notificationBehavior`) ordinary
 * notifications suppressed.
 * `endedProcessedAt` makes the end-of-maintenance re-evaluation (brief §10:
 * "if still offline after maintenance ends, notify once") idempotent per
 * window, independent of AttentionState's own transition bookkeeping;
 * `startedRecordedAt` similarly makes the automatic Activity transition at
 * the scheduled start idempotent across process restarts.
 */
model MaintenanceWindow {
  id                   String                          @id @default(cuid())
  scope                LifecycleScopeType
  nodeId               String?
  node                 Node?                           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  workloadId           String?
  workload             Project?                        @relation(fields: [workloadId], references: [id], onDelete: Cascade)
  createdById          String?
  createdBy            User?                           @relation("MaintenanceWindowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reason               String?
  startsAt             DateTime
  endsAt               DateTime
  notificationBehavior MaintenanceNotificationBehavior @default(SUPPRESS)
  cancelledAt          DateTime?
  cancelledById        String?
  cancelledBy          User?                           @relation("MaintenanceWindowCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  startedRecordedAt    DateTime?
  endedProcessedAt     DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@index([nodeId])
  @@index([workloadId])
  @@index([startsAt, endsAt])
}

/**
 * Notification destination (Phase 6E). URL and any auth token are stored
 * encrypted (AES-256-GCM via server/security/crypto.ts, a new
 * NOTIFICATION_DESTINATIONS purpose) and are never returned in full by any
 * API response after creation (see server/services/notifications.ts —
 * responses only ever include a masked suffix).
 */
model NotificationDestination {
  id                     String                      @id @default(cuid())
  name                   String
  type                   NotificationDestinationType @default(WEBHOOK)
  enabled                Boolean                     @default(true)
  urlEncrypted           String
  urlMasked              String // safe-to-display masked form, e.g. https://hooks.example.com/••••••
  authHeaderEncrypted    String?
  signingSecretEncrypted String
  minSeverity            AttentionSeverity           @default(WARNING)
  eventTypes             NotificationEventType[]
  scopeNodeIds           String[]                    @default([])
  scopeWorkloadIds       String[]                    @default([])
  consecutiveFailures    Int                         @default(0)
  lastDeliveryStatus     NotificationDeliveryStatus?
  lastDeliveryAt         DateTime?
  lastSuccessAt          DateTime?
  createdById            String?
  createdBy              User?                       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries             NotificationDelivery[]
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  @@index([enabled])
}

/**
 * A logical notification-worthy event, derived from one attention transition
 * (brief §11-13). `dedupeKey` is the idempotency anchor — deterministic from
 * the attention transition itself (e.g. `${attentionStateId}:OPENED:${firstObservedAt}`),
 * never from wall-clock "now", so a duplicate sync pass, worker restart, or
 * retried HTTP request can never create a second logical event for the same
 * transition (unique constraint, migration-enforced upsert-or-skip).
 * `payload` is the exact versioned structured payload later sent to every
 * matching destination — computed once here, not re-derived per delivery.
 */
model NotificationEvent {
  id               String                 @id @default(cuid())
  dedupeKey        String                 @unique
  type             NotificationEventType
  attentionStateId String?
  attentionState   AttentionState?        @relation(fields: [attentionStateId], references: [id], onDelete: SetNull)
  severity         AttentionSeverity?
  resourceType     String?
  resourceId       String?
  summary          String
  payload          Json
  occurredAt       DateTime               @default(now())
  deliveries       NotificationDelivery[]
  createdAt        DateTime               @default(now())

  @@index([attentionStateId])
  @@index([occurredAt])
}

/**
 * One delivery ATTEMPT of one NotificationEvent to one NotificationDestination
 * (brief's own conceptual model: "NotificationDelivery: one attempt to one
 * configured destination"). Retries append new rows
 * (notificationEventId, destinationId, attemptNumber) rather than mutating a
 * prior attempt — a manual retry is a new deliberate attempt, never a
 * duplicate of the logical event (brief §23). Secret request headers/tokens
 * are never persisted here, only the sanitized outcome.
 */
model NotificationDelivery {
  id                  String                     @id @default(cuid())
  notificationEventId String
  notificationEvent   NotificationEvent          @relation(fields: [notificationEventId], references: [id], onDelete: Cascade)
  destinationId       String
  destination         NotificationDestination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attemptNumber       Int                        @default(1)
  status              NotificationDeliveryStatus @default(PENDING)
  httpStatus          Int?
  error               String?
  isTest              Boolean                    @default(false)
  isManualRetry       Boolean                    @default(false)
  requestedAt         DateTime                   @default(now())
  startedAt           DateTime?
  respondedAt         DateTime?
  nextRetryAt         DateTime?
  createdAt           DateTime                   @default(now())

  @@unique([notificationEventId, destinationId, attemptNumber])
  @@index([destinationId, status])
  @@index([notificationEventId])
  @@index([status, nextRetryAt])
}
