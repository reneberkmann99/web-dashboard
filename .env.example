DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostpanel?schema=public"
SESSION_TTL_HOURS="12"
NODE_CREDENTIALS_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Managed deployment secrets (AES-256-GCM). 64 hex chars. Placeholder only — never commit a real key.
DEPLOYMENT_SECRETS_KEY=""
# Phase 6E notification credential encryption. Generate independently:
#   openssl rand -hex 32
NOTIFICATION_DESTINATIONS_KEY=""
INGRESS_PROVIDER_CREDENTIALS_KEY=""
# SMTP password encryption. Generate independently with `openssl rand -hex 32`.
SMTP_CREDENTIALS_KEY=""
# Canonical browser-facing platform origin for activation emails.
PLATFORM_PUBLIC_BASE_URL="https://platform.noderaft.ee"
# SMTP connection/auth/send timeout in milliseconds (1000–60000, default 10000).
SMTP_TIMEOUT_MS="10000"
# Browser-facing base URL used in notification deep links; HTTPS is mandatory.
HOSTPANEL_PUBLIC_BASE_URL="https://10.99.2.1:1337"
# Explicit SSRF policy. Keep false unless private n8n/OpenClaw receivers are intentional.
WEBHOOK_ALLOW_PRIVATE_NETWORKS="false"
WEBHOOK_TIMEOUT_MS="8000"

# VPN-facing TLS material is generated once on the host and bind-mounted read-only.
HOSTPANEL_TLS_DIR="/etc/hostpanel/tls"
HOSTPANEL_TLS_IP_SANS="10.99.2.1,100.126.152.141"
HOSTPANEL_TLS_DNS_SANS="vmi2804346"
HOSTPANEL_TLS_VALID_DAYS="825"
NODE_AGENT_TIMEOUT_MS="15000"
SEED_ADMIN_EMAIL="admin@noderaft.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CLIENT_PASSWORD="ClientPass123!"
NEXT_PUBLIC_APP_NAME="Noderaft"

# Agent local defaults
AGENT_PORT="8081"
AGENT_API_KEY="agent-dev-key"
AGENT_DOCKER_MODE="mock"
DOCKER_HOST=""
XDG_RUNTIME_DIR=""

# Fleet attention thresholds (all optional; defaults shown)
ATTENTION_HEARTBEAT_STALE_MS="90000"
ATTENTION_HEARTBEAT_OFFLINE_MS="300000"
ATTENTION_RESTART_WINDOW_MS="600000"
ATTENTION_RESTART_WARNING_COUNT="3"
ATTENTION_RESTART_CRITICAL_COUNT="8"
ATTENTION_NODE_CPU_WARNING_PCT="85"
ATTENTION_NODE_MEM_WARNING_PCT="85"
ATTENTION_NODE_DISK_WARNING_PCT="85"
ATTENTION_CONTAINER_SUSTAINED_SAMPLES="3"
ATTENTION_CONTAINER_CPU_WARNING_PCT="90"
ATTENTION_CONTAINER_MEM_WARNING_PCT="90"
ATTENTION_CONTAINER_MEM_CRITICAL_PCT="98"
# Optional read-only host path when the Docker data filesystem is unusual.
AGENT_HOST_DISK_PATH=""
