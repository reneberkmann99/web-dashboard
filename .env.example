DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostpanel?schema=public"
SESSION_TTL_HOURS="12"
NODE_CREDENTIALS_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Managed deployment secrets (AES-256-GCM). 64 hex chars. Placeholder only — never commit a real key.
DEPLOYMENT_SECRETS_KEY=""
NODE_AGENT_TIMEOUT_MS="15000"
SEED_ADMIN_EMAIL="admin@hostpanel.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CLIENT_PASSWORD="ClientPass123!"
NEXT_PUBLIC_APP_NAME="HostPanel"

# Agent local defaults
AGENT_PORT="8081"
AGENT_API_KEY="agent-dev-key"
AGENT_DOCKER_MODE="mock"
DOCKER_HOST=""
XDG_RUNTIME_DIR=""

# Fleet attention thresholds (all optional; defaults shown)
ATTENTION_HEARTBEAT_STALE_MS="90000"
ATTENTION_HEARTBEAT_OFFLINE_MS="300000"
ATTENTION_RESTART_WINDOW_MS="600000"
ATTENTION_RESTART_WARNING_COUNT="3"
ATTENTION_RESTART_CRITICAL_COUNT="8"
ATTENTION_NODE_CPU_WARNING_PCT="85"
ATTENTION_NODE_MEM_WARNING_PCT="85"
ATTENTION_NODE_DISK_WARNING_PCT="85"
ATTENTION_CONTAINER_SUSTAINED_SAMPLES="3"
ATTENTION_CONTAINER_CPU_WARNING_PCT="90"
ATTENTION_CONTAINER_MEM_WARNING_PCT="90"
ATTENTION_CONTAINER_MEM_CRITICAL_PCT="98"
# Optional read-only host path when the Docker data filesystem is unusual.
AGENT_HOST_DISK_PATH=""
